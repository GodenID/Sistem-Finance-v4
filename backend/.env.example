# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/finance_db

# JWT Configuration (No.9: secret WAJIB kuat min. 32 char acak di production —
# startup gagal bila masih default/lemah. JWT_EXPIRES_IN default '365d' (sesi persistent).)
# Generate baru: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=PASTE_JWT_SECRET_KUAT_MIN_32_KARAKTER_DISINI
JWT_PREVIOUS_SECRETS=
JWT_EXPIRES_IN=365d
JWT_ISSUER=finance-prasasti

# No.8: Reset password via email (Resend langsung, server-to-server)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Finance Prasasti <finance@prasastigroup.id>
APP_BASE_URL=https://finance.prasastigroup.id

# Kebijakan password & token reset
PASSWORD_MIN_LENGTH=8
RESET_TOKEN_TTL_MS=3600000

# No.10: ambang skor Guard untuk aksi sensitif (0 = hanya wajib bukti fresh)
GUARD_MIN_SCORE_SENSITIVE=0

# Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Proteksi bot kini via Turnstile gate kunjungan (frontend + Worker siteverify).
# Variabel Guard lama di bawah ini TIDAK LAGI dipakai (disimpan untuk arsip).
# GUARD_API_URL=https://guard.prasastigroup.id
# GUARD_ENABLED=true
# GUARD_TIMEOUT_MS=10000
# GUARD_MIN_SCORE=0

# Rate limit login (anti-bruteforce, in-memory per proses)
LOGIN_MAX_ATTEMPTS=5
LOGIN_USER_LOCK_MS=900000
LOGIN_MAX_ATTEMPTS_IP=20
LOGIN_IP_LOCK_MS=1800000
LOGIN_RATE_WINDOW_MS=900000
