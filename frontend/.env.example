# Supabase Self-Hosted Configuration
# Copy this file to .env and fill in your values
# Command: copy .env.example .env

# Supabase Connection
VITE_SUPABASE_URL=https://db-finance.prasastigroup.id
VITE_SUPABASE_ANON_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJzdXBhYmFzZSIsImlhdCI6MTc2NjIyODIyMCwiZXhwIjo0OTIxOTAxODIwLCJyb2xlIjoiYW5vbiJ9.GnKke7iKlZxy8SkOyQg33agbPSYOC1HQ9ItTUB-284A

# Cloudflare R2 Upload Worker (baru)
VITE_R2_WORKER_URL=https://finance-v3-upload.ranggadhisesa.workers.dev

# Cloudflare Worker untuk email notifikasi transfer via Resend
VITE_EMAIL_NOTIFICATION_URL=https://finance-v3-email.ranggadhisesa.workers.dev

# Backend Express sendiri (opsional tapi DISARANKAN untuk auth JWT persistent)
# Kosongkan untuk mode Supabase-direct.
VITE_BACKEND_URL=http://localhost:3001

# Cloudflare Turnstile — gate kunjungan sekali saja (bukan captcha per-form).
# Sitekey publik dari dash.cloudflare.com → Turnstile → widget
# (domains: localhost, 127.0.0.1, finance.prasastigroup.id).
VITE_TURNSTILE_SITEKEY=
# URL Worker siteverify hasil Spin (mis. https://turnstile-siteverify-xxx.workers.dev)
VITE_TURNSTILE_VERIFY_URL=
# Masa ingat gate (hari) — selama ini user tidak diminta verifikasi lagi
VITE_TURNSTILE_GATE_TTL_DAYS=30

# Sesi persistent — tidak ada logout otomatis (idle/absolute dihapus).
# Variabel lama di bawah ini TIDAK LAGI dipakai (arsip):
# VITE_PRASASTI_API_URL=https://guard.prasastigroup.id
# VITE_SESSION_IDLE_MINUTES=30
# VITE_SESSION_MAX_MINUTES=720
