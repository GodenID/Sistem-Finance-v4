# Konfigurasi frontend
# Copy this file to .env and fill in your values
# Command: copy .env.example .env

# WAJIB. URL backend Express. Semua query data lewat sini.
VITE_BACKEND_URL=http://localhost:3001

# Cloudflare R2 Upload Worker (baru)
VITE_R2_WORKER_URL=https://finance-v3-upload.ranggadhisesa.workers.dev

# Cloudflare Worker untuk email notifikasi transfer via Resend
VITE_EMAIL_NOTIFICATION_URL=https://finance-v3-email.ranggadhisesa.workers.dev

# Cloudflare Turnstile - gate kunjungan sekali saja (bukan captcha per-form).
# Sitekey publik dari dash.cloudflare.com -> Turnstile -> widget
# (domains: localhost, 127.0.0.1, finance.prasastigroup.id).
VITE_TURNSTILE_SITEKEY=
# URL Worker siteverify hasil Spin (mis. https://turnstile-siteverify-xxx.workers.dev)
VITE_TURNSTILE_VERIFY_URL=
# Masa ingat gate (hari) - selama ini user tidak diminta verifikasi lagi
VITE_TURNSTILE_GATE_TTL_DAYS=30
