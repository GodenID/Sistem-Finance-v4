# Konfigurasi frontend (mode backend API)
# Semua data lewat backend Express; tidak ada akses langsung ke database.

# WAJIB. Tanpa ini frontend tidak bisa memuat data.
VITE_BACKEND_URL=http://localhost:3001

# Worker upload (proxy ke S3 Onidel). Jangan pakai domain workers.dev:
# sebagian ISP Indonesia memblokirnya sehingga upload gagal.
VITE_R2_WORKER_URL=https://upload.prasastigroup.id

# Worker email notifikasi transfer via Resend.
VITE_EMAIL_NOTIFICATION_URL=https://notify.prasastigroup.id

# Cloudflare Turnstile - gate kunjungan sekali saja (bukan captcha per-form).
# Sitekey publik dari dash.cloudflare.com -> Turnstile -> widget
# (domains: localhost, 127.0.0.1, finance.prasastigroup.id).
VITE_TURNSTILE_SITEKEY=
# URL Worker siteverify hasil Spin (mis. https://turnstile.prasastigroup.id)
VITE_TURNSTILE_VERIFY_URL=
# Masa ingat gate (hari) - selama ini user tidak diminta verifikasi lagi
VITE_TURNSTILE_GATE_TTL_DAYS=30
