# Konfigurasi frontend (mode backend API)
# Semua data lewat backend Express; tidak ada akses langsung ke database.

# WAJIB. Tanpa ini frontend tidak bisa memuat data.
VITE_BACKEND_URL=http://localhost:3001

# Worker upload (proxy ke S3 Onidel; workers.dev diblokir ISP)
VITE_R2_WORKER_URL=https://upload.prasastigroup.id

# Cloudflare Worker untuk email notifikasi transfer via Resend
VITE_EMAIL_NOTIFICATION_URL=https://notify.prasastigroup.id

# Cloudflare Turnstile - gate kunjungan sekali saja (Spin)
VITE_TURNSTILE_SITEKEY=0x4AAAAAAE1FPMavLq99krrk
VITE_TURNSTILE_VERIFY_URL=https://turnstile.prasastigroup.id
VITE_TURNSTILE_GATE_TTL_DAYS=30
